{
  "expo": {
    "name": "هبّة",
    "slug": "habba-customer",
    "scheme": "habba",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "sa.habba.customer",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "sa.habba.customer",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-localization", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "http://localhost:54321",
      "supabaseAnonKey": "dev-anon-key"
    }
  }
}
