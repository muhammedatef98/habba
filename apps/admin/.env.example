# Habba ops console — configuration.
#
# Copy to `.env.local` (git-ignored). The same code runs locally and on Vercel;
# these variables are the only difference (Amendment B, CLAUDE.md §5.1.6).

# Leave both blank to run on the in-memory repository and the dev sign-in
# (ops@habba.sa, any password of 8 characters or more).
NEXT_PUBLIC_SUPABASE_URL=

# The client key. Public by design and useless unless RLS is wrong — the
# console reads and writes as the OPERATOR'S own session, and `is_ops()`
# decides what the database will answer.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SUPABASE_SERVICE_ROLE_KEY DOES NOT BELONG IN THIS FILE OR THIS APP.
# It is server-only — route handlers and server components exclusively — and
# never `NEXT_PUBLIC_`. RLS does not apply to it, so a copy that reaches the
# client bundle is a copy that reads every table in the project.
