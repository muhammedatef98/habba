{
  "expo": {
    "name": "هبّة",
    "slug": "habba",
    "scheme": "habba",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "newArchEnabled": true,
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "sa.habba.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "sa.habba.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12514F"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "enableProviderMode": false,
      "supabaseUrl": "http://localhost:54321",
      "supabaseAnonKey": "dev-anon-key"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
