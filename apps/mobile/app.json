{
  "expo": {
    "name": "هبّة",
    "slug": "habba",
    "owner": "muhammedatef98",
    "scheme": "habba",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "sa.habba.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ar",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sa.habba.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12514F"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "تستخدم هبّة الكاميرا لتصوير العطل قبل إرسال الفنّي، ولتوثيق العمل بصور قبل وبعد في دفتر السيارة.",
          "microphonePermission": "تستخدم هبّة الميكروفون لتسجيل صوت العطل في مقطع الفحص، ليعرف الفنّي المشكلة قبل أن يتحرّك.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "تستخدم هبّة الكاميرا لتصوير العطل قبل إرسال الفنّي، ولتوثيق العمل بصور قبل وبعد في دفتر السيارة.",
          "photosPermission": false,
          "microphonePermission": "تستخدم هبّة الميكروفون لتسجيل صوت العطل في مقطع الفحص، ليعرف الفنّي المشكلة قبل أن يتحرّك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "تستخدم هبّة الموقع لإرسال أقرب فنّي إلى سيارتك، ولمشاركة موقع الفنّي مع العميل أثناء توجّهه إليه."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12514F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "045794c7-1c02-411c-b2b7-68c4a3d2fe40"
      }
    }
  }
}
