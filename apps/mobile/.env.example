# Habba mobile — build-time configuration.
#
# Copy to `.env.local` (git-ignored) and fill in. Expo reads EXPO_PUBLIC_* at
# build time and INLINES them into the bundle, so everything here is readable
# by anyone holding the app.
#
# That is correct for these three values and for nothing else. The service-role
# key, the Unifonic credentials and the SMS hook secret are set on the SERVER
# (Supabase → Edge Functions → Secrets) and must never appear in this file.

# Leave the URL and the key blank to run on the in-memory repository and the
# dev OTP (123456).
EXPO_PUBLIC_SUPABASE_URL=

# The client key. Prefer the publishable key (`sb_publishable_…`) — it is not
# derived from the JWT signing secret, so it survives rotating that secret and
# can be revoked on its own. The legacy anon key still works and is read only
# when the publishable one is absent.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provider mode. Off until the KYC vault is real and an ops console exists to
# approve applications (ADR-0017). Set to exactly `true` to enable.
EXPO_PUBLIC_ENABLE_PROVIDER_MODE=false

# Public base for تقرير هبّة share links.
EXPO_PUBLIC_REPORT_BASE_URL=https://habba.sa/r
